{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "firebase emulators:exec --project demo-janggi-go --only auth,firestore,database \"jest --runInBand\"",
    "emulators": "npm run build && firebase emulators:start --project demo-janggi-go",
    "init-app-config": "node lib/scripts/initAppConfig.js",
    "set-admin": "node lib/scripts/setAdmin.js",
    "seed": "npm run build && node lib/scripts/seedEmulator.js"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "dayjs": "^1.11.23",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/jest": "^30.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^13.1.0",
    "firebase-functions-test": "^3.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "test/tsconfig.json"
        }
      ]
    }
  }
}
