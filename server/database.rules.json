{
  "rules": {
    ".read": false,
    ".write": false,
    "games_active": {
      "$gameId": {
        ".read": true
      }
    },
    "spectate_list": {
      ".read": true
    },
    "spectators": {
      "$gameId": {
        "$viewerId": {
          ".write": "!newData.exists() || (!data.exists() && $viewerId.length === 20 && root.child('games_active').child($gameId).exists())",
          ".validate": "newData.isNumber() && newData.val() === now"
        }
      }
    },
    "connections": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren()",
        "$connectionId": {
          ".validate": "newData.hasChildren(['online', 'foreground', 'activeSince', 'lastSeenAt'])",
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "foreground": {
            ".validate": "newData.isBoolean()"
          },
          "activeSince": {
            ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
          },
          "lastSeenAt": {
            ".validate": "newData.isNumber() && (newData.val() === now || newData.val() === data.val())"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chats_lobby": {
      ".read": "auth != null",
      ".indexOn": ["sentAt"]
    },
    "chats_game": {
      "$gameId": {
        ".read": "auth != null && (root.child('games_active').child($gameId).child('meta/players/cho/uid').val() === auth.uid || root.child('games_active').child($gameId).child('meta/players/han/uid').val() === auth.uid)"
      }
    },
    "chats_spectator": {
      "$gameId": {
        ".read": "auth != null && (root.child('games_active').child($gameId).child('state/phase').val() === 'finished' || (root.child('games_active').child($gameId).child('meta/players/cho/uid').val() !== auth.uid && root.child('games_active').child($gameId).child('meta/players/han/uid').val() !== auth.uid))"
      }
    },
    "online_users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !newData.exists()",
        "challengesEnabled": {
          ".write": "auth != null && auth.uid === $uid && data.exists() && newData.exists()",
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}
