rules_version = '2';

// 기본 거부에서 시작하고 필요한 경로만 연다(docs/database.md의 보안 규칙 방향).
// 여기에 없는 컬렉션은 클라이언트가 읽지도 쓰지도 못한다. 서버(Admin SDK)는 규칙을 거치지 않는다.
// 서버 전용: nicknames, ratings, nickname_changes, quick_queue, challenge_limits, reports,
// moderation_logs, chat_checks, sanctions.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 운영 설정. 앱이 로그인 전에도 읽는다. 쓰기는 Admin 웹의 Callable(Functions)만 한다.
    match /configs/app {
      allow read: if true;
    }

    // 공개 프로필. Functions와 대국 서버만 쓴다.
    match /users/{uid} {
      allow read: if signedIn();

      // 차단 목록. 본인만 읽고, 만들고, 지운다. 고치기는 막는다. 대국 서버는 신청을 전달할 때 읽는다.
      match /blocks/{blockedUid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && blockedUid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }
    }

    // 본인만 보는 정보. 본인은 challengesEnabled만 바꿀 수 있다.
    match /users_private/{uid} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challengesEnabled'])
        && request.resource.data.challengesEnabled is bool;
    }

    // 사용자가 지금 무엇을 하고 있는지(대기열, 방, 대국, 신청). 본인만 읽고 대국 서버만 쓴다.
    match /player_states/{uid} {
      allow read: if isOwner(uid);
    }

    // 방. 로그인한 사용자가 ID(초대 링크)로 읽는다. 목록은 공개된 기다리는 방만 조회할 수 있어 비공개 방은 ID를 아는
    // 사람만 읽는다. 대국 서버만 쓴다.
    match /rooms/{roomId} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.listed == true && resource.data.status == 'waiting';
    }

    // 끝난 대국의 기보와 결과. 로그인한 사용자가 읽는다(내 기보 목록, 나와의 전적). 대국 서버만 쓴다.
    match /games_archived/{gameId} {
      allow read: if signedIn();
    }

    // 대국 신청. 보낸 사람과 받는 사람만 ID로 읽는다. 대국 서버만 쓴다.
    match /challenges/{challengeId} {
      allow get: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
  }
}
